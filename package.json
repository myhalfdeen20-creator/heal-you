{
  "name": "healyou-ummul-mukminin",
  "version": "1.0.0",
  "description": "HealYou - Arsitektur Psikologi Perempuan & Ummul Mukminin",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run watch:css\" \"node server.js\"",
    "build": "npm run build:css",
    "start": "node server.js",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./public/styles.css --watch"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "canvas": "^3.2.3",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
